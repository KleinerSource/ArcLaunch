#!/bin/sh
set -e

payload=/var/mobile/Library/ArcLaunch/KeyboardBridge

if [ -d /var/jb/usr/lib ]; then
    destination=/var/jb/Library/MobileSubstrate/DynamicLibraries
else
    destination=/Library/MobileSubstrate/DynamicLibraries
fi

mkdir -p "$destination"
cp -f "$payload/ArcLaunchGuestKeyboardBridge.dylib" "$destination/ArcLaunchGuestKeyboardBridge.dylib"
cp -f "$payload/ArcLaunchGuestKeyboardBridge.plist" "$destination/ArcLaunchGuestKeyboardBridge.plist"
chmod 755 "$destination/ArcLaunchGuestKeyboardBridge.dylib"
chmod 644 "$destination/ArcLaunchGuestKeyboardBridge.plist"

case "$1" in
    configure) ;;
    *) exit 0 ;;
esac

if [ -n "${SILEO:-}${CYDIA:-}" ]; then
    printf '%s\n' 'finish:restart' >&6 2>/dev/null || true
fi
